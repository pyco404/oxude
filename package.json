{
  "name": "oxude",
  "version": "0.0.1",
  "private": true,
  "description": "Oxude match engine \u2014 agent-versus-agent betting game.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx scripts/balance.ts",
    "check": "npm run typecheck && npm run test",
    "sweep": "tsx scripts/sweep.ts",
    "search": "tsx scripts/search.ts",
    "inspect": "tsx scripts/inspect.ts",
    "score-policies": "tsx scripts/score-policies.ts",
    "brief-sweep": "tsx scripts/brief-sweep.ts",
    "seed-roster": "tsx scripts/seed-roster.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "serve": "tsx scripts/serve.ts",
    "chain:build": "cd chain && anchor build && cp target/idl/oxude_settlement.json ../src/chain/idl.json && cp target/types/oxude_settlement.ts ../src/chain/idl-types.ts",
    "test:chain": "CHAIN=1 vitest run test/chain.test.ts",
    "start": "tsx scripts/serve.ts --migrate"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@electric-sql/pglite": "^0.5.8",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
